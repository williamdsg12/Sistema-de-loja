{
  "name": "wsgestorpdv-gestao-loja",
  "version": "1.0.0",
  "description": "Sistema de Gestão para Loja e PDV estilo Nex para Windows (Offline First)",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "electron:build": "npm run build && npm run build:electron && electron-builder --win",
    "test:api": "node scripts/test_api_parity.cjs",
    "pack": "npm run build && npm run build:electron && electron-builder --dir",
    "dist": "npm run electron:build",
    "start": "electron ."
  },
  "keywords": [
    "pdv",
    "nex",
    "gestao-loja",
    "electron",
    "sqlite",
    "react",
    "windows"
  ],
  "author": "Antigravity Dev",
  "license": "MIT",
  "dependencies": {
    "@types/jsbarcode": "^3.11.4",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.12.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "pdf-parse": "^2.4.5",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.wsgestaopdv.gestao",
    "productName": "WS Gestão PDV",
    "directories": {
      "output": "release-dist"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "schema.sql",
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "verifyUpdateCodeSignature": false,
      "signAndEditExecutable": false,
      "sign": null
    },
    "forceCodeSigning": false,
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WS Gestão PDV"
    }
  }
}
